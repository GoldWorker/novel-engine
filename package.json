{
  "name": "novel-engine",
  "version": "0.4.0",
  "description": "Pure-frontend TypeScript Novel Engine SDK (Ports & Adapters). Engine, route, MemoryStore, OpfsStore, Worker host, book snapshot zip, optional fetch LLM adapters, and a same-thread host session (inspect, generate, ChapterRunner, foundation impact, Worker bridge).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js",
      "default": "./dist/llm.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js",
      "default": "./dist/session.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:short": "vitest run tests/engine.short-book.test.ts",
    "test:layered": "vitest run tests/engine.layered-book.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "novel",
    "engine",
    "sdk",
    "typescript",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoldWorker/novel-engine.git"
  },
  "bugs": {
    "url": "https://github.com/GoldWorker/novel-engine/issues"
  },
  "homepage": "https://github.com/GoldWorker/novel-engine#readme",
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
